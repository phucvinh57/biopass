#!/bin/bash

set -e

case "$1" in
    configure)
        # Biopass finds /usr/lib/biopass through RUNPATH now. Packages up to
        # 1.4.2 shipped /etc/ld.so.conf.d/biopass.conf; dpkg removes it on
        # upgrade, this drops its entries from the linker cache.
        ldconfig
        # Rewrite /etc/pam.d/common-* from the current profile, so an upgrade
        # from 1.4.2 replaces the old "sufficient" line. --package only
        # refreshes profiles the admin already enabled; it never enables
        # this one (Default: no).
        if command -v pam-auth-update >/dev/null 2>&1; then
            pam-auth-update --package
        fi
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
