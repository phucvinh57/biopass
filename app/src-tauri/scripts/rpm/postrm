#!/bin/sh
# $1 is 0 on uninstall, 1 or more on upgrade: keep the module on upgrade.
if [ "$1" = "0" ] && command -v semodule >/dev/null 2>&1 \
    && semodule -l 2>/dev/null | grep -qx biopass; then
    semodule -r biopass \
        || echo "biopass: SELinux module not removed; run: semodule -r biopass" >&2
fi
exit 0
