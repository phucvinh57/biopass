{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "biopass",
  "identifier": "com.ticklab.biopass",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Biopass",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/faces/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "fprintd",
          "libwebkit2gtk-4.1-0",
          "libturbojpeg0 | libturbojpeg",
          "libegl1",
          "libgles2",
          "pkexec | policykit-1",
          "libtss2-esys-3.0.2-0t64 | libtss2-esys-3.0.2-0",
          "libtss2-mu-4.0.1-0t64 | libtss2-mu-4.0.1-0",
          "libtss2-tcti-device0t64 | libtss2-tcti-device0"
        ],
        "postInstallScript": "scripts/deb/postinst",
        "preRemoveScript": "scripts/deb/prerm",
        "postRemoveScript": "scripts/deb/postrm",
        "desktopTemplate": "scripts/biopass.desktop",
        "files": {
          "/lib/security/libbiopass_pam.so": "../../auth/build/pam/libbiopass_pam.so",
          "/usr/bin/biopass-helper": "../../auth/build/pam/biopass-helper",
          "/usr/libexec/biopass/biopass-keyring": "../../auth/build/keyring/biopass-keyring",
          "/usr/share/polkit-1/actions/com.ticklab.biopass.policy": "scripts/com.ticklab.biopass.policy",
          "/usr/lib/biopass/libbiopass_det.so": "../../auth/build/face/detection/libbiopass_det.so",
          "/usr/lib/biopass/libbiopass_reg.so": "../../auth/build/face/recognition/libbiopass_reg.so",
          "/usr/lib/biopass/libbiopass_as.so": "../../auth/build/face/antispoofing/libbiopass_as.so",
          "/usr/lib/biopass/libonnxruntime.so.1": "../../auth/build/_deps/onnxruntime-src/lib/libonnxruntime.so.1.31.1",
          "/usr/lib/biopass/libcamera.so.0.8": "../../auth/build/libcamera-bundle/libcamera.so.0.8",
          "/usr/lib/biopass/libcamera-base.so.0.8": "../../auth/build/libcamera-bundle/libcamera-base.so.0.8",
          "/usr/lib/biopass/libcamera/ipa/ipa_softisp.so": "../../auth/build/libcamera-bundle/libcamera/ipa/ipa_softisp.so",
          "/usr/lib/biopass/libcamera/softisp_ipa_proxy": "../../auth/build/libcamera-bundle/libcamera/softisp_ipa_proxy",
          "/usr/share/biopass/libcamera/ipa/softisp/uncalibrated.yaml": "../../auth/build/libcamera-bundle/ipa/softisp/uncalibrated.yaml",
          "/usr/share/pam-configs/biopass": "scripts/pam.conf"
        }
      },
      "rpm": {
        "depends": [
          "fprintd",
          "turbojpeg",
          "libglvnd-egl",
          "libglvnd-gles",
          "tpm2-tss",
          "polkit"
        ],
        "desktopTemplate": "scripts/biopass.desktop",
        "files": {
          "/lib64/security/libbiopass_pam.so": "../../auth/build/pam/libbiopass_pam.so",
          "/usr/bin/biopass-helper": "../../auth/build/pam/biopass-helper",
          "/usr/libexec/biopass/biopass-keyring": "../../auth/build/keyring/biopass-keyring",
          "/usr/share/polkit-1/actions/com.ticklab.biopass.policy": "scripts/com.ticklab.biopass.policy",
          "/usr/lib/biopass/libbiopass_det.so": "../../auth/build/face/detection/libbiopass_det.so",
          "/usr/lib/biopass/libbiopass_reg.so": "../../auth/build/face/recognition/libbiopass_reg.so",
          "/usr/lib/biopass/libbiopass_as.so": "../../auth/build/face/antispoofing/libbiopass_as.so",
          "/usr/lib/biopass/libonnxruntime.so.1": "../../auth/build/_deps/onnxruntime-src/lib/libonnxruntime.so.1.31.1",
          "/usr/lib/biopass/libcamera.so.0.8": "../../auth/build/libcamera-bundle/libcamera.so.0.8",
          "/usr/lib/biopass/libcamera-base.so.0.8": "../../auth/build/libcamera-bundle/libcamera-base.so.0.8",
          "/usr/lib/biopass/libcamera/ipa/ipa_softisp.so": "../../auth/build/libcamera-bundle/libcamera/ipa/ipa_softisp.so",
          "/usr/lib/biopass/libcamera/softisp_ipa_proxy": "../../auth/build/libcamera-bundle/libcamera/softisp_ipa_proxy",
          "/usr/share/biopass/libcamera/ipa/softisp/uncalibrated.yaml": "../../auth/build/libcamera-bundle/ipa/softisp/uncalibrated.yaml"
        }
      }
    }
  }
}
